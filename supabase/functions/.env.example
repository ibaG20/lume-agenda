ALLOWED_ORIGINS=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000

# Optional availability cache and public rate limiting. Database remains authoritative.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
AVAILABILITY_CACHE_TTL_SECONDS=60

# Use EMAIL_MODE=test locally to exercise the outbox without sending messages.
EMAIL_MODE=test
EMAIL_WORKER_SECRET=replace-with-a-long-random-secret
RESEND_API_KEY=
RESEND_FROM=Lume Agendas <agendamento@example.com>
SEND_EMAIL_HOOK_SECRET=v1,whsec_replace-with-the-secret-generated-by-supabase

# Web Push. Generate one VAPID key pair and keep the private key server-only.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:agendas@example.com

